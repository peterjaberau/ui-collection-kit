{
  "name": "@ui-collection-kit",
  "private": true,
  "author": "Peter Jaber",
  "license": "MIT",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "style-actors-demo": "pnpm --filter \"./demos/style-actors-demo\"",
    "start-style-actors-demo": "pnpm style-actors-demo dev",
    "ui-atlaskit": "pnpm --filter \"./demos/ui-atlaskit\"",
    "start-ui-atlaskit": "pnpm ui-atlaskit dev",
    "ui-kit-extended": "pnpm --filter \"./demos/ui-kit-extended\"",
    "start-ui-kit-extended": "pnpm ui-kit-extended dev",
    "template-starter": "pnpm --filter \"./templates/starter\"",
    "start-template-starter": "pnpm template-starter dev",
    "template-hr": "pnpm --filter \"./templates/hr\"",
    "start-template-hr": "pnpm template-hr dev",
    "demos-react-lite": "pnpm --filter \"./demos/react-lite\"",
    "start-demos-react-lite": "pnpm demos-react-lite dev",
    "packages": "pnpm --filter=./packages/** -r",
    "build": "pnpm packages -- build",
    "postbuild": "pnpm document-types && pnpm document-attr",
    "sync-pkgs": "tsx scripts/sync-packages.ts",
    "clean-pkgs": "pnpm -r exec rm -rf dist .swc *.log",
    "clean": "pnpm clean-pkgs && rm -rf node_modules",
    "nextjs-demo": "pnpm --filter \"./demos/nextjs-demo\"",
    "start-nextjs-demo": "pnpm nextjsdemo dev",
    "unstyled-react": "pnpm --filter \"./packages/unstyled/react\"",
    "start-unstyled-react": "pnpm unstyled-react storybook",
    "generate-machine": "plop machine && pnpm sync-pkgs",
    "generate-util": "plop utility && pnpm sync-pkgs",
    "typecheck": "pnpm packages -- typecheck",
    "prettier": "prettier --check packages/**/*",
    "prettier-fix": "prettier --write packages/**/*",
    "lint": "eslint packages",
    "document-types": "tsx scripts/typedocs.ts",
    "document-attr": "tsx scripts/data-attr.ts"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": "prettier --write"
  },
  "dependencies": {
    "@chakra-ui/charts": "^3.21.0",
    "@chakra-ui/react": "^3.21.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@eslint/eslintrc": "3.3.1",
    "@sourcegraph/amp": "0.0.1751775018-g24e802",
    "@statelyai/agent": "1.1.6",
    "@statelyai/inspect": "^0.4.0",
    "@swc/core": "1.11.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "22.14.1",
    "@types/signale": "1.4.7",
    "@typescript-eslint/eslint-plugin": "8.30.1",
    "@typescript-eslint/parser": "8.30.1",
    "@xstate/graph": "^3.0.2",
    "@xstate/react": "^5.0.3",
    "@xstate/store": "^3.4.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.5.0",
    "eslint": "9.24.0",
    "eslint-config-prettier": "10.1.2",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.2.6",
    "fast-glob": "3.3.3",
    "find-packages": "10.0.4",
    "mutative": "1.1.0",
    "node-fetch": "3.3.2",
    "prettier": "3.5.3",
    "prettier-plugin-svelte": "3.3.3",
    "recharts": "^3.0.0",
    "scule": "1.3.0",
    "set-value": "4.1.0",
    "signale": "1.4.0",
    "ts-morph": "25.0.1",
    "ts-results": "^3.3.0",
    "tsup": "8.4.0",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vercel-submodules": "1.0.10",
    "vite-plugin-dts": "4.5.3",
    "vitest": "3.1.1",
    "xstate": "^5.19.2"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.21.1",
    "@storybook/addon-a11y": "9.0.13",
    "@storybook/addon-docs": "^9.0.13",
    "@storybook/addon-themes": "^9.0.13",
    "@storybook/react-vite": "9.0.13",
    "@types/react": ">=18.3.1",
    "@types/react-dom": ">=18.3.1",
    "@types/set-value": "4.0.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8",
    "react": ">=18.3.1",
    "react-dom": ">=18.3.1",
    "storybook": "9.0.13",
    "styled-components": "^6.1.8",
    "tailwind-merge": "^2.5.4",
    "tailwind-variants": "^0.2.1",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "vite": "6.3.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.8.1"
}

{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "jsx": "preserve",
    "declaration": true,
    "declarationMap": true,
    "moduleDetection": "force",
    "noUncheckedIndexedAccess": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "#codemirror-illa/*": ["./src/app/demos/codemirror-illa/*"],
      "#codemirror-illa": ["./src/app/demos/codemirror-illa/"],


      "#state-actors/*": ["./src/app/common/state-actors/*"],
      "#state-actors": ["./src/app/common/state-actors/"],


      //      state-actors


      "#app/*": ["./src/app/*"],
      "#app": ["./src/app"],

      "#registry/*": ["./src/modules/registry/*"],
      "#registry": ["./src/modules/registry"],

      "#modules/*": ["./src/modules/*"],
      "#modules": ["./src/modules"],


      "#dockview/*": ["./src/modules/dockview/view/*"],
      "#dockview": ["./src/modules/dockview/view"],

      "#demos/*": ["./src/demos/*"],
      "#demos": ["./src/demos"],

      "#components/*": ["./src/components/*"],
      "#components": ["./src/components"],

      "#nodedemo": ["./src/demos/node"],
      "#nodedemo/*": ["./src/demos/node/*"],


      "@/hooks/*": ["./src/hooks/*"],
      "@/hooks": ["./src/hooks"],

      "#core/*": ["./src/core/*"],
      "#core": ["./src/core"],
      "#core-utils/*": ["./src/core/utils/*"],
      "#core-utils": ["./src/core/utils"],



      "#common/*": ["./src/common/*"],
      "#common": ["./src/common"],


      "@/*": ["./*"],
      "~/*": ["./public/*"],
      "@/components/*": ["./components/*"],
      "@/components": ["./components"],
      "#actors/*": ["./src/actors/*"],
      "#actor-hooks/*": ["./actors/hooks*"],

      "#blocks/*": ["./blocks/*"],
      "#utils/*": ["./utils/*"],
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.mjs",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

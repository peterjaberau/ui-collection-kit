{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "jsx": "preserve",
    "declaration": true,
    "declarationMap": true,
    "moduleDetection": "force",
    "noUncheckedIndexedAccess": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "#providers/*": ["./src/providers/*"],
      "#providers": ["./src/providers"],
      "#design/*": ["./src/packages/design/*"],
      "#design": ["./src/packages/design"],

      "#presets/*": ["./src/presets/*"],
      "@/*": ["./*"],
      "~/*": ["./public/*"],
      "@/components/*": ["./components/*"],
      "@/components": ["./components"],
      "#actors/*": ["./actors/*"],
      "#actor-hooks/*": ["./actors/hooks*"],
      "#app/*": ["./app/*"],
      "#components/*": ["./components/*"],
      "#blocks/*": ["./blocks/*"],
      "#utils/*": ["./utils/*"],

      "@/redux/*": ["./src/redux/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/store": ["./src/store"],
      "@/api/*": ["./src/api/*"],
      "@/config/*": ["./src/config/*"],
      "@/middleware/*": ["./src/middleware/*"],
      "@/constants/*": ["./src/constants/*"],
      "@/public/*": ["./src/packages/public/*"],
      "@/design/*": ["./src/packages/design/*"],
      "@/page/*": ["./src/page/*"],
      "@/services/*": ["./src/services/*"],
      "@/i18n/*": ["./src/i18n/*"],
      "@/widgetLibrary/*": ["./src/widgetLibrary/*"],
      "@/assets/*": ["./src/assets/*"],
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.mjs",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "jsx": "preserve",
    "declaration": true,
    "declarationMap": true,
    "moduleDetection": "force",
    "noUncheckedIndexedAccess": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "#illa": ["./src/illa"],
      "#illa/*": ["./src/illa/*"],

      "@/public": ["./src/illa/packages/public"],
      "@/public/*": ["./src/illa/packages/public/*"],

      "#actors": ["./src/actors"],
      "#actors/*": ["./src/actors/*"],

      "#actor-workers": ["./src/actors/workers"],
      "#actor-workers/*": ["./src/actors/workers/*"],

      "#actor-constants": ["./src/actors/lib/constants"],
      "#actor-constants/*": ["./src/actors/lib/constants/*"],

      "#actor-types": ["./src/actors/lib/types"],
      "#actor-types/*": ["./src/actors/lib/types/*"],

      "#actor-utils":  ["./src/actors/lib/utils"],
      "#actor-utils/*":  ["./src/actors/lib/utils/*"],

      "#actor-lib":  ["./src/actors/lib"],
      "#actor-lib/*":  ["./src/actors/lib/*"],

      "#actors-hook": ["./src/actors/hooks"],
      "#actors-hook/*": ["./src/actors/hooks/*"],

      "#components/*": ["./src/components/*"],

      "@/*": ["./*"],
      "~/*": ["./public/*"],
      "@/components/*": ["./components/*"],
      "@/components": ["./components"],

      "#actor-hooks/*": ["./actors/hooks*"],
      "#app/*": ["./app/*"],

      "#blocks/*": ["./blocks/*"],
      "#utils/*": ["./utils/*"],

      "actions/*": ["./src/appsmith/actions/*"],
      "api/*": ["./src/appsmith/api/*"],
      "ce/*": ["./src/appsmith/ce/*"],
      "constants/*": ["./src/appsmith/constants/*"],
      "entities/*": ["./src/appsmith/entities/*"],
      "pages/*": ["./src/appsmith/pages/*"],
      "plugins/*": ["./src/appsmith/plugins/*"],
      "polyfills/*": ["./src/appsmith/polyfills/*"],
      "utils/*": ["./src/appsmith/utils/*"],
      "workers/*": ["./src/appsmith/workers/*"],
      "sagas/*": ["./src/appsmith/sagas/*"],
      "selectors/*": ["./src/appsmith/selectors/*"],
      "reducers/*": ["./src/appsmith/reducers/*"],
      "components/*": ["./src/appsmith/components/*"],
      "@shared/*": ["./src/appsmith/shared/*"],
      "PluginActionEditor/*": ["./src/appsmith/PluginActionEditor/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.mjs",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
